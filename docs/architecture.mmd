flowchart LR

    DEV["Developer"]
    GH["GitHub<br/>Feature Branches + master"]
    GHCR["GHCR<br/>kk-payments:v1.2.0"]

    DEV -->|Commit / PR| GH
    GH --> JENKINS

    subgraph CICD["Jenkins CI/CD"]
        direction TB

        JENKINS["CI<br/>Lint • Build • Verify"]
        SEC["Tests + Security Audit"]
        INFRA["Validate Infrastructure"]
        AR["Prepare Ansible Runtime"]
        CONFIG["Configure Staging"]
        PRESTG["Verify Staging Prerequisites"]
        DSTG["Deploy Staging"]
        SMOKE["Smoke Test"]
        MON["Error Rate Check<br/>&gt;5% = ALERT"]
        APPROVE["Production Approval<br/>Manual Gate"]
        PREPROD["Verify Production Prerequisites"]
        DPROD["Deploy Production"]

        JENKINS --> SEC
        SEC --> INFRA
        INFRA --> AR
        AR --> CONFIG
        CONFIG --> PRESTG
        PRESTG --> DSTG
        DSTG --> SMOKE
        SMOKE --> MON
        MON --> APPROVE
        APPROVE --> PREPROD
        PREPROD --> DPROD
    end

    subgraph IAC["Infrastructure & Configuration"]
        direction TB

        TF["Terraform<br/>kijani-staging namespace"]
        ANS["Ansible<br/>Staging ConfigMap"]
        AWSTF["Terraform<br/>AWS receipt resources"]
    end

    INFRA -.-> TF
    CONFIG -.-> ANS

    subgraph STAGING["Kubernetes — kijani-staging"]
        direction TB

        STGCFG["ConfigMap<br/>staging environment"]
        STGSEC["Kubernetes Secrets"]
        STGPAY["kk-payments<br/>3 replicas<br/>Node.js 20<br/>v1.2.0"]
        STGSVC["Service / Ingress"]

        STGCFG --> STGPAY
        STGSEC --> STGPAY
        STGPAY --> STGSVC
    end

    DSTG --> STGPAY
    GHCR -->|Pull image| STGPAY
    ANS --> STGCFG

    subgraph RECEIPTS["AWS — Staging Receipt Chain"]
        direction LR

        S3IN["S3<br/>incoming/"]
        PROC["Receipt Processor<br/>Lambda"]
        S3PROC["S3<br/>processed/<br/>PROCESSED"]
        NOTIFY["Notifier<br/>Lambda"]
        S3NOTIFY["S3<br/>notifications/<br/>SENT"]
        CW["CloudWatch"]

        S3IN -->|ObjectCreated| PROC
        PROC --> S3PROC
        PROC -->|Async invoke| NOTIFY
        NOTIFY --> S3NOTIFY

        PROC -.-> CW
        NOTIFY -.-> CW
    end

    AWSTF -.-> RECEIPTS
    STGPAY -->|Successful payment<br/>Publish receipt| S3IN

    subgraph PROD["Kubernetes — kijani-project"]
        direction TB

        PRODCFG["ConfigMap<br/>production environment<br/>RECEIPTS_BUCKET unset"]
        PRODSEC["Kubernetes Secrets"]
        PRODPAY["kk-payments<br/>3 replicas<br/>Node.js 20<br/>v1.2.0"]
        PRODSVC["Service / Ingress"]
        DISABLED["Receipt publishing<br/>DISABLED"]

        PRODCFG --> PRODPAY
        PRODSEC --> PRODPAY
        PRODPAY --> PRODSVC
        PRODPAY -.-> DISABLED
    end

    DPROD --> PRODPAY
    GHCR -->|Same image| PRODPAY

    SAME["Same Kubernetes Deployment manifest<br/>Staging + Production"]
    SAME -.-> STGPAY
    SAME -.-> PRODPAY

    SMOKE -.->|GET /health| STGSVC
    MON -.->|20 probes| STGSVC
